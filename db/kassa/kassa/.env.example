# Скопируйте этот файл в .env и впишите свои значения.
# Сам .env в git не попадает (см. .gitignore) — там реальные пароли.

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=kassa

PORT=3001

# Любая случайная строка — используется для подписи токенов входа.
# Сгенерировать можно так: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# SMS-провайдер для сброса пароля (необязательно, можно оставить пустым)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Kassa
